# Backend environment variables (loaded by src/api.py via python-dotenv).
# Copy to .env and fill in real values -- .env is gitignored and must never
# be committed.

# Required for the AI Analyst / anomaly & household explanation endpoints
# (src/ai/llm_client.py). Without it, those endpoints return HTTP 503.
OPENROUTER_API_KEY=

# Optional. Comma-separated list of allowed frontend origins for CORS.
# Defaults to http://localhost:3000 if unset. When the Next.js frontend is
# also accessed from another device on the LAN, add that device-facing
# origin here, e.g.:
#   FRONTEND_ORIGINS=http://localhost:3000,http://<this-machine-LAN-IP>:3000
FRONTEND_ORIGINS=
